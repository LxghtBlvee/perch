{
  "name": "perch",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:hub": "bun run --cwd apps/hub dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:agent": "bun run --cwd apps/agent dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "typescript-eslint": "^8.60.1"
  }
}